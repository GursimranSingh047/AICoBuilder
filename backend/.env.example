# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=ProjectPilot
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-32chars

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/projectpilot
# For SQLite (dev fallback):
# DATABASE_URL=sqlite:///./projectpilot.db

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── OpenAI / Gemini ─────────────────────────────────────────────────────────
# Supply your OpenAI-style API key here. The code keeps an internal `GEMINI_*` set
# but reads the key from `openai_api_key` for compatibility with your .env.
openai_api_key=your-openai-api-key-here
OPENAI_MODEL=gemini-1.5-flash

# ─── Project Storage ─────────────────────────────────────────────────────────
PROJECTS_DIR=./generated_projects

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
