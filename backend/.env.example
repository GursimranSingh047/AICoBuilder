# ============================================================================
# ProjectPilot Backend - Environment Variables Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env to Git (it's in .gitignore)
# ============================================================================

# ── AI API Configuration ────────────────────────────────────────────────────
# Choose ONE of the following providers:

# Option 1: OpenRouter (Recommended - Access to multiple models)
# Get your key from: https://openrouter.ai/keys
openai_api_key=sk-or-v1-YOUR_OPENROUTER_KEY_HERE
OPENAI_MODEL=gpt-3.5-turbo

# Option 2: Google Gemini
# Get your key from: https://makersuite.google.com/app/apikey
# openai_api_key=AIzaYOUR_GEMINI_KEY_HERE
# OPENAI_MODEL=gemini-2.0-flash

# Option 3: OpenAI
# Get your key from: https://platform.openai.com/api-keys
# openai_api_key=sk-YOUR_OPENAI_KEY_HERE
# OPENAI_MODEL=gpt-4

# ── Application Configuration ───────────────────────────────────────────────
# Secret key for JWT tokens (generate a strong random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_IN_PRODUCTION

# Application settings
APP_NAME=ProjectPilot
APP_VERSION=1.0.0
DEBUG=True

# ── Database Configuration ──────────────────────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite:///./projectpilot.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/projectpilot

# ── JWT Configuration ───────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS Configuration ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Storage Configuration ───────────────────────────────────────────────────
PROJECTS_DIR=./generated_projects

# ============================================================================
# DEPLOYMENT NOTES:
# ============================================================================
# For production deployment:
# 1. Set DEBUG=False
# 2. Use a strong SECRET_KEY (32+ characters)
# 3. Use PostgreSQL instead of SQLite
# 4. Update ALLOWED_ORIGINS with your production domain
# 5. Never expose these values in frontend code
# ============================================================================
