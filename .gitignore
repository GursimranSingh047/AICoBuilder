# ============================================================================
# ProjectPilot - Comprehensive .gitignore
# ============================================================================

# ── Python ──────────────────────────────────────────────────────────────────
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual environments
.venv/
venv/
ENV/
env/
.env.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Node.js / Frontend ──────────────────────────────────────────────────────
# Dependencies
node_modules/
jspm_packages/

# Production builds
dist/
build/
.next/
out/

# Testing
coverage/

# Misc
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env files
.env
.env*.local

# Vercel
.vercel

# Vite
.vite/

# ── Database ────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
test.db

# ── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Generated Files ─────────────────────────────────────────────────────────
# Generated projects (keep structure, ignore content)
backend/generated_projects/*
!backend/generated_projects/.gitkeep

# ML models (if large)
*.pkl
*.h5
*.model

# ── Secrets & Environment ───────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
secrets/

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Temporary Files ─────────────────────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
*~

# ── Docker ──────────────────────────────────────────────────────────────────
*.log
docker-compose.override.yml

# ── Kiro Specs (keep structure) ─────────────────────────────────────────────
# Keep spec files but ignore temporary files
.kiro/**/*.tmp

# ── Root Level Cleanup ──────────────────────────────────────────────────────
# Remove root-level app.py if it's not needed
app.py
