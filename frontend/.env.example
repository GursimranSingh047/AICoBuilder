# ============================================================================
# ProjectPilot Frontend - Environment Variables Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace placeholder values with your actual configuration
# 3. NEVER commit .env to Git (it's in .gitignore)
# ============================================================================

# ── API Configuration ───────────────────────────────────────────────────────
# Backend API URL
# Development: http://localhost:8000
# Production: https://your-backend-domain.com
VITE_API_URL=http://localhost:8000

# ── Application Configuration ───────────────────────────────────────────────
VITE_APP_NAME=ProjectPilot
VITE_APP_VERSION=1.0.0

# ── Feature Flags ───────────────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ACTIVITY_TRACKING=true

# ============================================================================
# IMPORTANT SECURITY NOTES:
# ============================================================================
# 1. NEVER put API keys or secrets in frontend .env files
# 2. All VITE_ prefixed variables are PUBLIC and exposed in the browser
# 3. Sensitive operations should always go through your backend API
# 4. For production, update VITE_API_URL to your deployed backend URL
# ============================================================================

# ============================================================================
# DEPLOYMENT INSTRUCTIONS:
# ============================================================================
# Vercel/Netlify:
# - Add these variables in your project settings dashboard
# - They will be injected at build time
#
# Example for Vercel:
# 1. Go to Project Settings → Environment Variables
# 2. Add: VITE_API_URL = https://your-backend.com
# 3. Redeploy your application
# ============================================================================
